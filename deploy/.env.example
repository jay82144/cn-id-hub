# ===========================================
# Identity Hub - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ----- Domain Configuration -----
# Frontend domain (e.g., id.example.com)
FRONTEND_URL=https://id.example.com

# Backend/API domain (e.g., api-id.example.com)
BACKEND_URL=https://api-id.example.com

# CORS origins (comma-separated, include frontend URL)
CORS_ORIGINS=https://id.example.com

# ----- Database Configuration -----
POSTGRES_USER=identity_hub
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=identity_hub

# ----- JWT Configuration -----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ----- Magic Link Configuration -----
MAGIC_LINK_EXPIRATION_MINUTES=15

# ----- Security -----
# Trusted hosts for backend (comma-separated)
TRUSTED_HOSTS=api-id.example.com,localhost

# ----- Default Admin User -----
# Created on first startup (must change password on first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeOnFirstLogin!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
