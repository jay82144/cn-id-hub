# ============================================================
# IDENTITY HUB - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in the values
# Generate passwords with: openssl rand -base64 24

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL superuser password (for administration and bootstrap scripts)
POSTGRES_PASSWORD=CHANGE_THIS_SUPERUSER_PASSWORD

# ID App database settings
DB_HOST=shared-postgres
DB_PORT=5432
DB_NAME=id_app
DB_USER=id_app_user
# ID App user password (separate from superuser)
DB_PASSWORD=CHANGE_THIS_APP_USER_PASSWORD

# ============================================================
# JWT & AUTH CONFIGURATION
# ============================================================
# IMPORTANT: Generate a secure random string (min 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAGIC_LINK_EXPIRATION_MINUTES=15

# ============================================================
# URL CONFIGURATION
# ============================================================
# External URL where the Identity Hub will be accessible
# This is used for OAuth callbacks and CORS
ID_APP_BASE_URL=https://id.yourdomain.com

# Internal URL (for service-to-service communication within Docker)
ID_APP_INTERNAL_URL=http://id-backend:8000

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed origins (NO wildcards in production)
# Include your frontend URL and any other apps that will use the Identity Hub
ALLOWED_CORS_ORIGINS=https://id.yourdomain.com,https://app1.yourdomain.com

# ============================================================
# COOKIE SECURITY
# ============================================================
# Set to 'true' for HTTPS (production), 'false' for HTTP (development only)
COOKIE_SECURE=true

# ============================================================
# O365 / MICROSOFT SSO (Optional)
# ============================================================
# Leave empty to disable Microsoft SSO
# Get these from Azure Portal > App registrations
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ============================================================
# BOOTSTRAP ADMIN CREDENTIALS
# ============================================================
# Initial admin account - MUST change email AND password on first login
BOOTSTRAP_ADMIN_EMAIL=admin.new@local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!
